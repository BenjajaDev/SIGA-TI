{
  "name": "@siga/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file=../../.env prisma/seed/base.ts",
    "db:seed:demo": "tsx --env-file=../../.env prisma/seed/demo.ts",
    "db:reset": "prisma migrate reset --force",
    "openapi:generate": "tsx src/interfaces/http/openapi/generate.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@siga/shared": "workspace:*",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "yaml": "^2.8.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^17.0.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
