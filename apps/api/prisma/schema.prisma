// Propuesta Etapa 1 — se instalará en apps/api/prisma/schema.prisma (Etapa 2).
// Prisma 7.10.1: la URL de conexión vive en prisma.config.ts (DATABASE_URL), no aquí.
// Pendiente: validar con `prisma validate` (docs de prisma.io no accesibles en esta sesión).
// Las restricciones CHECK y el trigger de inmutabilidad se añaden en migración SQL manual
// (ver data-model.md §5).

generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/persistence/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SOLICITANTE
  TECNICO
  SUPERVISOR
  ADMIN
}

enum TicketStatus {
  ABIERTA
  ASIGNADA
  EN_PROGRESO
  EN_ESPERA
  RESUELTA
  CERRADA
}

enum Priority {
  CRITICA
  ALTA
  MEDIA
  BAJA
}

enum TicketEventType {
  CREATED
  ASSIGNED
  REASSIGNED
  STATUS_CHANGED
}

enum CommentVisibility {
  PUBLICO
  INTERNO
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  fullName     String    @db.VarChar(120)
  role         Role
  isActive     Boolean   @default(true)
  // Solo lo usa el adaptador de identidad simulado; se elimina al migrar a OIDC.
  passwordHash String?   @db.VarChar(255)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  refreshTokens     RefreshToken[]
  requestedTickets  Ticket[]       @relation("TicketRequester")
  assignedTickets   Ticket[]       @relation("TicketAssignee")
  actedEvents       TicketEvent[]  @relation("EventActor")
  fromAssigneeEvents TicketEvent[] @relation("EventFromAssignee")
  toAssigneeEvents  TicketEvent[]  @relation("EventToAssignee")
  comments          Comment[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  // SHA-256 hex del token opaco; el token en claro nunca se persiste.
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  tickets Ticket[]

  @@map("categories")
}

model SlaPolicy {
  id              String   @id @default(uuid()) @db.Uuid
  priority        Priority @unique
  resolutionHours Int
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@map("sla_policies")
}

model Ticket {
  id          String       @id @default(uuid()) @db.Uuid
  // Secuencia para el código legible SIGA-000123 (se deriva en el dominio).
  number      Int          @unique @default(autoincrement())
  title       String       @db.VarChar(120)
  description String       @db.VarChar(5000)
  categoryId  String       @db.Uuid
  priority    Priority
  status      TicketStatus @default(ABIERTA)
  requesterId String       @db.Uuid
  assigneeId  String?      @db.Uuid
  dueAt       DateTime     @db.Timestamptz(3)
  resolvedAt  DateTime?    @db.Timestamptz(3)
  closedAt    DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  category  Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  requester User          @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee  User?         @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  events    TicketEvent[]
  comments  Comment[]

  @@index([status, createdAt])
  @@index([assigneeId, status])
  @@index([requesterId])
  @@map("tickets")
}

model TicketEvent {
  id             String          @id @default(uuid()) @db.Uuid
  ticketId       String          @db.Uuid
  type           TicketEventType
  actorId        String          @db.Uuid
  fromStatus     TicketStatus?
  toStatus       TicketStatus?
  fromAssigneeId String?         @db.Uuid
  toAssigneeId   String?         @db.Uuid
  note           String?         @db.VarChar(1000)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  ticket       Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor        User   @relation("EventActor", fields: [actorId], references: [id], onDelete: Restrict)
  fromAssignee User?  @relation("EventFromAssignee", fields: [fromAssigneeId], references: [id], onDelete: Restrict)
  toAssignee   User?  @relation("EventToAssignee", fields: [toAssigneeId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}

model Comment {
  id         String            @id @default(uuid()) @db.Uuid
  ticketId   String            @db.Uuid
  authorId   String            @db.Uuid
  body       String            @db.VarChar(2000)
  visibility CommentVisibility @default(PUBLICO)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("comments")
}

model BrandSettings {
  id              String   @id @default("default")
  institutionName String   @db.VarChar(80)
  primaryColor    String   @db.Char(7)
  secondaryColor  String   @db.Char(7)
  gradientAngle   Int
  logoDataUrl     String?  @db.Text
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@map("brand_settings")
}
