# SIGA-TI — variables de entorno de ejemplo (valores ficticios, solo desarrollo local)
# Copiar a .env y ajustar. Nunca versionar .env ni usar estos valores en producción.

# --- API ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://siga:siga_dev_password@localhost:5432/siga_ti
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
JWT_ACCESS_SECRET=dev-only-change-me-0000000000000000000000
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
SWAGGER_ENABLED=true

# --- PostgreSQL local (docker-compose.yml) ---
POSTGRES_USER=siga
POSTGRES_PASSWORD=siga_dev_password
POSTGRES_DB=siga_ti
POSTGRES_PORT=5432

# --- Pruebas de integración ---
TEST_DATABASE_URL=postgresql://siga:siga_dev_password@localhost:5432/siga_ti_test

# --- Semillas (datos ficticios; no se ejecutan en producción) ---
SEED_DEFAULT_PASSWORD=Demo-Siga-2026!

# --- Web (Vite) ---
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_PROXY_TARGET=http://localhost:3000
